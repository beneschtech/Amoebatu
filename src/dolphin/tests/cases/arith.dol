print(5 & 3, 5 | 3, 5 ^ 3, ~5, 1 << 10, 1024 >> 3)
print(1 < 2 < 3, 1 < 3 < 2, 2 == 2.0, 3 != 4)
print(True and 0, 0 or "x", not None)
