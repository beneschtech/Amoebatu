# Parallel fills (fill.hpp): `for i in ...: out[i] = f(...)` into a list the
# function created runs as a parallel map, then stores in order. Output must
# be exactly what the sequential loop gives, including on failure.

def work(x):
    t = 0
    for k in range(200):
        t = (t + x * k) % 1000003
    return t

def check(x):
    if x == 37:
        raise ValueError(f"bad record {x}")
    return x * 2

def basic(n):
    out = array(n)
    for i in range(n):
        out[i] = work(i)
    return out

def backwards(n):           # any index expression, any iterable
    out = [0] * n
    for i in range(n):
        out[n - 1 - i] = work(i)
    return out

def partial(n):             # a failing call: earlier slots filled, later ones untouched
    out = array(n, -1)
    i = -5
    try:
        for i in range(n):
            out[i] = check(i)
    except ValueError as e:
        print("caught:", e.message, "i =", i, "around:", out[36], out[37], out[38])
    return out

def bad_index(n):           # a store out of range: the IndexError the loop would raise
    out = array(n)
    i = -1
    try:
        for i in range(n + 2):
            out[i] = check(i % 30)
    except IndexError as e:
        print("IndexError:", e.message, "i =", i, "last:", out[n - 1])

def into_dict(names):       # a dict works too, in loop order
    d = {}
    for nm in names:
        d[nm] = work(len(nm))
    return d

def escapes(n):             # out is aliased: stays sequential (still correct)
    out = array(n)
    other = out
    for i in range(n):
        out[i] = work(i)
    return other

def recurrence(n):          # the arguments read out: stays sequential
    out = array(n, 1)
    for i in range(1, n):
        out[i] = check(out[i - 1])
    return out

def main():
    a = basic(300)
    print(len(a), a[0], a[1], a[299], sum(a))
    b = backwards(300)
    print(b[0] == a[299], b[299] == a[0])
    p = partial(60)
    print(p[0], p[36], p[37], p[59])
    bad_index(10)
    print(into_dict(["a", "bb", "ccc", "bb"]))
    print(sum(escapes(100)), recurrence(5))
    print(array(3), array(2, "x"), array(0), [None] * 2)
    try:
        array(-1)
    except ValueError as e:
        print("ValueError:", e.message)
