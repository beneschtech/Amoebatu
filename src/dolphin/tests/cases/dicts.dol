d[1.0] = "uno"
print(d, len(d))
print(d["KCOS"], d.get("KXXX"), d.get("KXXX", -1), "KDEN" in d, True in d, 2 in d)
print(d.keys(), d.values())
print(d.pop(1), d, d.pop("nope", "dflt"))
for k in d:
    print(k, d[k])
print(sorted(d), sorted([3, 1.5, 2]), sorted(["b", "a", "c"]))
counts = {}
for w in "the cat and the hat and the bat".split():
    counts[w] = counts.get(w, 0) + 1
print(counts)
print({"a": [1, 2], "b": {"c": None}} == {"b": {"c": None}, "a": [1, 2]}, {} == {}, {1: 2} == {1: 3})
print({1: "x"}[True], bool({}), bool({0: 0}))
