def main():
    s = "  Hi "
    f = s.strip
    print(f())
    print(f)
    d = {"a": 1, 2: "two"}
    print(d["a"], d[2], d.get("zz", 0))
    try:
        print(d["nope"])
    except KeyError as e:
        print("KeyError", e.message)
    try:
        x = [1, 2].upper()
    except AttributeError as e:
        print("AttributeError", e.message)
    try:
        y = s.frobnicate()
    except AttributeError as e:
        print("AttributeError", e.message)
    print(1 + 2 * 3 - 4 // 3, 2 ** 10, -7 % 3, not 0, 1 < 2 <= 2, "a" in "cat", 3 not in [1, 2])
    n = 5
    n -= 2
    n **= 2
    print(n, ~5, -n, 7 & 3 | 8 ^ 1, 1 << 4 >> 2)
