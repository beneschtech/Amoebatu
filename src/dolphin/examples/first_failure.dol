# first_failure.dol: LANGUAGE.md decision 17 in practice.
#
#   dolphin --threads 1 examples/first_failure.dol   # sequential: program order
#   dolphin --threads 4 examples/first_failure.dol   # parallel: first to return
#
# Several calls inside one try fail. Sequentially, the first one in program
# order is the only one that ever runs. In parallel they all start at once, and
# the failure that *returns* first is reported: here the fast one. Calls before
# the reported failure in program order finish and keep their results. Calls
# after it are cancelled, and their assignments don't happen.
#
# The scenario runs twice. Round 1 runs inline: a function is only sent to a
# thread once it's been measured and found worth it, and nothing has been
# measured yet. Round 2 uses what round 1 measured.

def work(n: int) -> int:
    total = 0
    for i in range(n):
        total += i % 7
    return total

def fails_after(n: int, label: str) -> int:
    work(n)
    raise ValueError(label)

def scenario(round: int):
    before = "unset"
    slow = "unset"
    fast = "unset"
    after = "unset"
    try:
        before = work(20000)                     # succeeds: its result stands
        slow = fails_after(200000, "slow failure")
        fast = fails_after(1000, "fast failure")
        after = work(400000)                     # later than the failure: cancelled
        print("not reached")
    except ValueError as e:
        print(f"round {round}: reported:", e)
    print("  before =", before)
    print("  slow =", slow, "  fast =", fast, "  after =", after)

def main():
    scenario(1)
    scenario(2)
